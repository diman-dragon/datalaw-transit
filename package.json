{
  "name": "datalaw-transit",
  "private": true,
  "version": "2.1.1",
  "description": "DataLaw Transit — офлайн-расписание общественного транспорта Белграда",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "icons": "python3 scripts/make_icons.py",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "npm run build && npx cap sync android && npm run android:prepare"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
